{
  "name": "dsh-side-chat-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Selection quotes and side chats for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bitilli/dsh-side-chat-plugin.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "side-chat",
    "quotes"
  ],
  "author": "Bitilli",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
